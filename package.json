{
  "name": "@geryenkohawsen/sen-ui",
  "version": "0.1.8",
  "description": "Open-source, Zen-inspired React + Tailwind CSS component library for calm, accessible UIs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./sen-ui.css": "./dist/sen-ui.css",
    "./*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app src",
    "bundle": "tsup --tsconfig ./tsconfig.build.json && tailwindcss --config ./tailwind.config.ts -i ./styles/index.css -o ./dist/sen-ui.css --minify"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "react-hook-form": "^7.58.1",
    "tailwind-merge": "^3.2.0"
  },
  "peerDependencies": {
    "next": "^15.0.0 || ^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.4.6",
    "@shikijs/engine-javascript": "^3.4.0",
    "@shikijs/langs": "^3.4.0",
    "@shikijs/themes": "^3.4.0",
    "@tailwindcss/cli": "^4.3.5",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-x": "^5.30.6",
    "globals": "^16.4.0",
    "next": "^16.4.6",
    "postcss": "^8.5.33",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^3.4.0",
    "tailwindcss": "^4.3.5",
    "tsup": "^8.5.0",
    "typescript": "^5",
    "typescript-eslint": "^8.73.0"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y-x": {
      "minimatch": "11.0.1"
    },
    "tsup": {
      "esbuild": "0.28.2"
    }
  },
  "resolutions": {
    "eslint-plugin-jsx-a11y-x/minimatch": "11.0.1",
    "tsup/esbuild": "0.28.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/geryenkohawsen/sen-ui.git"
  },
  "bugs": {
    "url": "https://github.com/geryenkohawsen/sen-ui/issues"
  },
  "homepage": "https://www.sen-ui.com/",
  "author": "Geryenko Hawsen <gery.zarons@gmail.com>",
  "license": "MIT",
  "keywords": [
    "react",
    "nextjs",
    "ui",
    "components",
    "tailwindcss",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "yarn@4.9.1+sha256.6ffc213b3ce0af5c92507977d9537ea3cc085caa52d1c3f08e94d613407fed19"
}
